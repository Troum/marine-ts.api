APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

FRONTEND_URL=http://localhost:3000

# Письма: абсолютный URL логотипа (по умолчанию FRONTEND_URL/logo-red.svg). Для продакшена задайте FRONTEND_URL на публичный сайт.
# MARINE_MAIL_LOGO_URL=https://example.com/logo-red.svg
# Ссылка с логотипа (по умолчанию FRONTEND_URL)
# MARINE_MAIL_SITE_URL=https://example.com
DOCUMENT_UPLOAD_TOKEN_TTL_DAYS=14

# Origin фронта (через запятую, без слэша). Обязательно для продакшена, иначе браузер заблокирует API (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://marine-ts.mytests.space

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marine_ts
DB_USERNAME=marine
DB_PASSWORD=marine

# Локальный SQLite (например для простых сценариев): DB_CONNECTION=sqlite и DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Анкета (PDF на cv@marin-ts.com по умолчанию). См. config/mail.php application_form
APPLICATION_FORM_NOTIFICATION_EMAIL=cv@marin-ts.com
# Обратная совместимость, если APPLICATION_FORM_* не задан
CREWING_NOTIFICATION_EMAIL=cv@marin-ts.com

# Заявки с сайта: судовой менеджмент (source_page ship-management) и остальные
INQUIRY_SHIP_MANAGEMENT_EMAILS=sblokhin@marin-ts.com,info@marin-ts.com
INQUIRY_DEFAULT_EMAILS=info@marin-ts.com

# Скрытая копия исходящих транзакционных писем (временно)
MTS_MAIL_HIDDEN_BCC=ev@vg-comp.ru,troum@outlook.com

LARAVEL_PDF_DRIVER=dompdf

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Laravel Telescope: доступ к /telescope и форма /telescope-auth/login (email через запятую)
# TELESCOPE_DASHBOARD_EMAILS=admin@example.com
# TELESCOPE_ENABLED=true
# TELESCOPE_PATH=telescope
# На стенде: писать все запросы в Telescope (иначе вне local видны только ошибки)
# TELESCOPE_RECORD_ALL=true

VITE_APP_NAME="${APP_NAME}"

# Оптимизация JPEG/PNG и WebP sidecar при POST /media (jpegoptim, optipng, cwebp)
# MEDIA_IMAGE_OPTIMIZE=true
# MEDIA_IMAGE_JPEG_MAX_QUALITY=85
# MEDIA_IMAGE_STRIP_EXIF=true
# MEDIA_IMAGE_PNG_LEVEL=2
# MEDIA_IMAGE_GENERATE_WEBP=true
# MEDIA_IMAGE_WEBP_QUALITY=82
